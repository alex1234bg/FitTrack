@using FitTrack.Models
@using Microsoft.AspNetCore.Identity

@{
    ViewData["Title"] = "My Profile";
    var user         = ViewBag.User         as ApplicationUser;
    var userPrograms = ViewBag.UserPrograms  as IList<UserProgram> ?? new List<UserProgram>();
}

<div class="container mt-3">
<div class="row g-4 mt-1">

    @* --- Account info card --- *@
    <div class="col-lg-4">
        <div class="card shadow-sm text-center">
            <div class="card-body py-4">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:80px;height:80px;font-size:2rem;">
                    @user?.Email?[0].ToString().ToUpper()
                </div>
                <h5 class="card-title mb-1">@user?.Email</h5>
                <p class="text-muted small mb-3">@user?.Email</p>

                <ul class="list-group list-group-flush text-start">
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Email confirmed</span>
                        @if (user?.EmailConfirmed == true)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">No</span>
                        }
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Enrolled programs</span>
                        <span class="badge bg-primary">@userPrograms.Count</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between">
                        <span>Completed</span>
                        <span class="badge bg-success">@userPrograms.Count(up => up.IsCompleted)</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    @* --- Enrolled programs --- *@
    <div class="col-lg-8">
        <h3 class="h5 mb-3">My Programs</h3>

        @if (!userPrograms.Any())
        {
            <div class="alert alert-info">
                You haven't enrolled in any programs yet.
                <a asp-controller="WorkoutPrograms" asp-action="Index">Browse programs</a> to get started.
            </div>
        }
        else
        {
            <div class="list-group shadow-sm">
                @foreach (var up in userPrograms)
                {
                    <div class="list-group-item list-group-item-action">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                            <div>
                                <h6 class="mb-1 fw-semibold">@up.WorkoutProgram.Name</h6>
                                <small class="text-muted">
                                    Started: @up.StartDate.ToString("MMM d, yyyy")
                                    &nbsp;&bull;&nbsp;
                                    @up.WorkoutProgram.DurationWeeks weeks
                                    &nbsp;&bull;&nbsp;
                                    @up.WorkoutProgram.Level / @up.WorkoutProgram.Category
                                </small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-secondary">@up.CompletedWorkouts workouts done</span>
                                @if (up.IsCompleted)
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">In progress</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3">
                <a asp-controller="WorkoutPrograms" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    + Enroll in another program
                </a>
            </div>
        }
    </div>

</div>
</div> @* /container *@
