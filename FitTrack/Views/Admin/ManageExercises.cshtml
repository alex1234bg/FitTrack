@model FitTrack.Models.WorkoutProgram
@using FitTrack.Models

@{
    ViewData["Title"] = $"Admin — Exercises: {Model.Name}";
    var newEx = ViewBag.NewExercise as ExerciseCreateViewModel ?? new ExerciseCreateViewModel { WorkoutProgramId = Model.Id };
    bool showErrors = TempData["CreateError"] is not null;
}

<div class="container mt-3">

    @if (TempData["Success"] is string msg)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @msg <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Programs</a></li>
            <li class="breadcrumb-item"><a asp-action="Edit" asp-route-id="@Model.Id">@Model.Name</a></li>
            <li class="breadcrumb-item active">Manage Exercises</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Exercises</h1>
            <small class="text-muted">
                @Model.Name &bull;
                @Model.ProgramExercises.Count exercise(s)
            </small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Programs</a>
    </div>

    @* ── Exercises table ───────────────────────────────────────────────────── *@
    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Muscle Group</th>
                        <th class="text-center">Sets</th>
                        <th class="text-center">Reps / Sec</th>
                        <th class="text-center" style="min-width:130px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{int row = 0;}
                    @foreach (var pe in Model.ProgramExercises)
                    {
                        row++;
                        var unitLabel = pe.Exercise.RepUnit switch { RepUnit.Seconds => "sec", RepUnit.Minutes => "min", _ => "reps" };
                        <tr>
                            <td class="text-muted small">@row</td>
                            <td>
                                <div class="fw-semibold">@pe.Exercise.Name</div>
                                <small class="text-muted text-truncate d-block" style="max-width:280px">
                                    @pe.Exercise.Description
                                </small>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@pe.Exercise.MuscleGroup</span>
                            </td>
                            <td class="text-center fw-semibold">@pe.Exercise.Sets</td>
                            <td class="text-center fw-semibold">
                                @pe.Exercise.Reps
                                <span class="text-muted fw-normal small">@unitLabel</span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a asp-action="ExerciseEdit"
                                       asp-route-id="@pe.ExerciseId"
                                       asp-route-programId="@Model.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <form asp-action="ExerciseDelete" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="exerciseId" value="@pe.ExerciseId" />
                                        <input type="hidden" name="programId"  value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete exercise \'@pe.Exercise.Name\'?')">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.ProgramExercises.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No exercises yet. Add one below.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── Add new exercise form ─────────────────────────────────────────────── *@
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">+ Add New Exercise</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="ExerciseCreate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WorkoutProgramId" value="@Model.Id" />

                @if (showErrors)
                {
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                }

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Name <span class="text-danger">*</span></label>
                        <input name="Name" value="@newEx.Name" class="form-control"
                               placeholder="e.g. Barbell Squat" maxlength="100" required />
                        @if (showErrors)
                        {
                            <span asp-validation-for="@newEx.Name" class="text-danger small"></span>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Muscle Group <span class="text-danger">*</span></label>
                        <input name="MuscleGroup" value="@newEx.MuscleGroup" class="form-control"
                               placeholder="e.g. Quadriceps" maxlength="100" required />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
                        <textarea name="Description" class="form-control" rows="2"
                                  placeholder="Describe proper form and technique..." maxlength="1000" required>@newEx.Description</textarea>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label fw-semibold">Sets <span class="text-danger">*</span></label>
                        <input name="Sets" type="number" value="@(newEx.Sets == 0 ? 3 : newEx.Sets)"
                               class="form-control" min="1" max="20" required />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label fw-semibold" id="createRepsLabel">
                            Reps <span class="text-danger">*</span>
                        </label>
                        <input name="Reps" id="createRepsInput" type="number"
                               value="@(newEx.Reps == 0 ? 10 : newEx.Reps)"
                               class="form-control" min="1"
                               max="@(newEx.RepUnit == RepUnit.Seconds ? 300 : newEx.RepUnit == RepUnit.Minutes ? 60 : 100)" required />
                    </div>
                    <div class="col-sm-3 d-flex flex-column">
                        <label class="form-label fw-semibold">Unit</label>
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check" name="RepUnit" id="createUnitReps"
                                   value="@((int)RepUnit.Reps)" autocomplete="off"
                                   @(newEx.RepUnit == RepUnit.Reps ? "checked" : "") />
                            <label class="btn btn-outline-secondary" for="createUnitReps">Reps</label>

                            <input type="radio" class="btn-check" name="RepUnit" id="createUnitSeconds"
                                   value="@((int)RepUnit.Seconds)" autocomplete="off"
                                   @(newEx.RepUnit == RepUnit.Seconds ? "checked" : "") />
                            <label class="btn btn-outline-secondary" for="createUnitSeconds">Seconds</label>

                            <input type="radio" class="btn-check" name="RepUnit" id="createUnitMinutes"
                                   value="@((int)RepUnit.Minutes)" autocomplete="off"
                                   @(newEx.RepUnit == RepUnit.Minutes ? "checked" : "") />
                            <label class="btn btn-outline-secondary" for="createUnitMinutes">Minutes</label>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold">
                            Image URL <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input name="ImageUrl" value="@newEx.ImageUrl" class="form-control"
                               placeholder="https://..." maxlength="500" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-success px-4">Add Exercise</button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const repsLabel = document.getElementById('createRepsLabel');
            const repsInput = document.getElementById('createRepsInput');

            function syncUnit() {
                const isSeconds = document.getElementById('createUnitSeconds').checked;
                const isMinutes = document.getElementById('createUnitMinutes').checked;
                if (isSeconds) {
                    repsLabel.innerHTML = 'Seconds <span class="text-danger">*</span>';
                    repsInput.max = '300';
                } else if (isMinutes) {
                    repsLabel.innerHTML = 'Minutes <span class="text-danger">*</span>';
                    repsInput.max = '60';
                } else {
                    repsLabel.innerHTML = 'Reps <span class="text-danger">*</span>';
                    repsInput.max = '100';
                }
            }

            document.getElementById('createUnitReps').addEventListener('change', syncUnit);
            document.getElementById('createUnitSeconds').addEventListener('change', syncUnit);
            document.getElementById('createUnitMinutes').addEventListener('change', syncUnit);
            syncUnit();
        })();
    </script>
}
