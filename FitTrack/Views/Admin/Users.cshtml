@model IEnumerable<FitTrack.Models.ApplicationUser>

@{
    ViewData["Title"] = "Admin — Users";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>
                    ?? new Dictionary<string, IList<string>>();
}

<div class="container mt-3">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0">Users</h1>
            <small class="text-muted">@Model.Count() registered user(s)</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Programs</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Email</th>
                        <th>Email Confirmed</th>
                        <th>Roles</th>
                        <th class="text-center">Enrolled Programs</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var roles = userRoles.TryGetValue(user.Id, out var r) ? r : new List<string>();
                        <tr>
                            <td>
                                <span class="fw-semibold">@user.Email</span>
                                <br />
                                <small class="text-muted font-monospace">@user.Id[..8]…</small>
                            </td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <span class="badge bg-success">Confirmed</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                            </td>
                            <td>
                                @if (roles.Any())
                                {
                                    foreach (var role in roles)
                                    {
                                        var roleClass = role == "Admin" ? "bg-danger" : "bg-primary";
                                        <span class="badge @roleClass me-1">@role</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">No roles</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary fs-6">@user.UserPrograms.Count</span>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
