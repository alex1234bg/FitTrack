@model FitTrack.Models.ExerciseEditViewModel
@using FitTrack.Models

@{
    ViewData["Title"] = $"Admin — Edit Exercise: {Model.Name}";
}

<div class="container mt-3">

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Programs</a></li>
            <li class="breadcrumb-item">
                <a asp-action="ManageExercises" asp-route-id="@Model.ProgramId">Exercises</a>
            </li>
            <li class="breadcrumb-item active">Edit: @Model.Name</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Edit Exercise</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ExerciseEdit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ProgramId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MuscleGroup" class="form-label fw-semibold"></label>
                            <input asp-for="MuscleGroup" class="form-control" />
                            <span asp-validation-for="MuscleGroup" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-4">
                                <label asp-for="Sets" class="form-label fw-semibold"></label>
                                <input asp-for="Sets" type="number" class="form-control" min="1" max="20" />
                                <span asp-validation-for="Sets" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-4">
                                <label class="form-label fw-semibold" id="editRepsLabel">
                                    @(Model.RepUnit == RepUnit.Seconds ? "Seconds" : Model.RepUnit == RepUnit.Minutes ? "Minutes" : "Reps")
                                </label>
                                <input asp-for="Reps" id="editRepsInput" type="number" class="form-control"
                                       min="1" max="@(Model.RepUnit == RepUnit.Seconds ? 300 : Model.RepUnit == RepUnit.Minutes ? 60 : 100)" />
                                <span asp-validation-for="Reps" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-4 d-flex flex-column">
                                <label class="form-label fw-semibold">Unit</label>
                                <div class="btn-group" role="group">
                                    <input type="radio" class="btn-check" asp-for="RepUnit" id="editUnitReps"
                                           value="@((int)RepUnit.Reps)" autocomplete="off" />
                                    <label class="btn btn-outline-secondary" for="editUnitReps">Reps</label>

                                    <input type="radio" class="btn-check" asp-for="RepUnit" id="editUnitSeconds"
                                           value="@((int)RepUnit.Seconds)" autocomplete="off" />
                                    <label class="btn btn-outline-secondary" for="editUnitSeconds">Seconds</label>

                                    <input type="radio" class="btn-check" asp-for="RepUnit" id="editUnitMinutes"
                                           value="@((int)RepUnit.Minutes)" autocomplete="off" />
                                    <label class="btn btn-outline-secondary" for="editUnitMinutes">Minutes</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">
                                Image URL <span class="text-muted fw-normal">(optional)</span>
                            </label>
                            <input asp-for="ImageUrl" class="form-control" />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                            <a asp-action="ManageExercises" asp-route-id="@Model.ProgramId"
                               class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const repsLabel = document.getElementById('editRepsLabel');
            const repsInput = document.getElementById('editRepsInput');

            function syncUnit() {
                const isSeconds = document.getElementById('editUnitSeconds').checked;
                const isMinutes = document.getElementById('editUnitMinutes').checked;
                if (isSeconds) { repsLabel.textContent = 'Seconds'; repsInput.max = '300'; }
                else if (isMinutes) { repsLabel.textContent = 'Minutes'; repsInput.max = '60'; }
                else { repsLabel.textContent = 'Reps'; repsInput.max = '100'; }
            }

            document.getElementById('editUnitReps').addEventListener('change', syncUnit);
            document.getElementById('editUnitSeconds').addEventListener('change', syncUnit);
            document.getElementById('editUnitMinutes').addEventListener('change', syncUnit);
            syncUnit();
        })();
    </script>
}
