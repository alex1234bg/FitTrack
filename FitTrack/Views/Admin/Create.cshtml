@model FitTrack.Models.WorkoutProgram
@using FitTrack.Models

@{
    ViewData["Title"] = "Admin — Create Program";
}

<div class="container mt-3">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Programs</a></li>
                    <li class="breadcrumb-item active">Create</li>
                </ol>
            </nav>

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Create New Program</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Beginner Full Body" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="4"
                                      placeholder="Describe the program goals and structure..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label asp-for="Level" class="form-label fw-semibold"></label>
                                <select asp-for="Level" class="form-select"
                                        asp-items="Html.GetEnumSelectList<Level>()"></select>
                                <span asp-validation-for="Level" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="Category" class="form-label fw-semibold"></label>
                                <select asp-for="Category" class="form-select"
                                        asp-items="Html.GetEnumSelectList<Category>()"></select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DurationWeeks" class="form-label fw-semibold">Duration (weeks)</label>
                            <input asp-for="DurationWeeks" type="number" class="form-control" min="1" max="52" />
                            <span asp-validation-for="DurationWeeks" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">Image URL <span class="text-muted fw-normal">(optional)</span></label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 p-3 border rounded bg-light">
                            <div class="form-check form-switch">
                                <input asp-for="IsWorkoutOnly" class="form-check-input" role="switch" />
                                <label asp-for="IsWorkoutOnly" class="form-check-label fw-semibold">
                                    Workout Only
                                </label>
                            </div>
                            <div class="text-muted small mt-1">
                                Когато е включено, програмата показва само упражнения — без седмичен план.
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success px-4">Create Program</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
