@model IEnumerable<FitTrack.Models.CalendarEntry>
@using FitTrack.Models

@{
    ViewData["Title"] = "Workout Calendar";

    int year         = ViewBag.Year;
    int month        = ViewBag.Month;
    string monthName = ViewBag.MonthName;
    int daysInMonth  = ViewBag.DaysInMonth;
    int firstOffset  = ViewBag.FirstDayOffset;   // 0=Mon … 6=Sun
    DateTime today   = ViewBag.Today;

    var prevMonth = month == 1 ? 12 : month - 1;
    var prevYear  = month == 1 ? year - 1 : year;
    var nextMonth = month == 12 ? 1 : month + 1;
    var nextYear  = month == 12 ? year + 1 : year;

    var byDay = Model
        .GroupBy(e => e.ScheduledDate.Day)
        .ToDictionary(g => g.Key, g => g.ToList());

    var programIds   = Model.Select(e => e.WorkoutProgramId).Distinct().OrderBy(x => x).ToList();
    var colorPalette = new[] { "#4f8ef7", "#22c55e", "#a855f7", "#f97316", "#06b6d4" };
    var programColor = programIds
        .Select((id, i) => (id, color: colorPalette[i % colorPalette.Length]))
        .ToDictionary(x => x.id, x => x.color);

    var dayNames = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
    var allProgramsList = (List<FitTrack.Models.WorkoutProgram>)ViewBag.AllPrograms;
}

<style>
    /* ── Page ─────────────────────────────────────────────────────────────── */
    .cal-page { background: #f1f5f9; min-height: calc(100vh - 120px); padding: 1.5rem 0 3rem; }

    /* ── Month nav ────────────────────────────────────────────────────────── */
    .cal-nav-btn {
        width: 36px; height: 36px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        background: #fff; border: 1.5px solid #e2e8f0;
        color: #475569; font-size: 1rem; cursor: pointer;
        transition: background .15s, border-color .15s, color .15s;
        text-decoration: none;
    }
    .cal-nav-btn:hover { background: #4f8ef7; border-color: #4f8ef7; color: #fff; }
    .cal-month-title { font-size: 1.1rem; font-weight: 700; color: #1e293b; min-width: 160px; text-align: center; }

    /* ── Calendar card ────────────────────────────────────────────────────── */
    .cal-card {
        background: #fff; border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,.07);
        overflow: hidden;
    }

    /* ── Header row ───────────────────────────────────────────────────────── */
    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
    .cal-head-row { background: #1e293b; }
    .cal-head {
        padding: .55rem 0; text-align: center;
        font-size: .72rem; font-weight: 700; letter-spacing: .08em;
        text-transform: uppercase; color: #94a3b8;
    }

    /* ── Day cells ────────────────────────────────────────────────────────── */
    .cal-cell {
        min-height: 100px;
        border-right: 1px solid #f1f5f9;
        border-bottom: 1px solid #f1f5f9;
        padding: 8px 8px 6px;
        cursor: pointer;
        transition: background .15s;
        position: relative;
        background: #fff;
    }
    .cal-cell:hover { background: #f8fafc; }
    .cal-cell.cal-empty { background: #fafafa; cursor: default; }
    .cal-cell.cal-today {
        background: #eff6ff !important;
        box-shadow: inset 0 0 0 2px #4f8ef7;
    }
    .cal-cell.cal-has-workout:hover { background: #f0f4ff; }
    .cal-cell.cal-all-done { background: #f0fdf4 !important; }
    .cal-cell.cal-all-done:hover { background: #dcfce7 !important; }
    .cal-cell.cal-today.cal-all-done { background: #dcfce7 !important; }

    /* Selected day */
    .cal-cell.selected-day {
        box-shadow: inset 0 0 0 2px #2C3E50;
        background: #EBF5FB !important;
    }
    .cal-cell.selected-day .cal-day-num { font-weight: 900 !important; }
    .cal-cell.selected-day:not(.cal-today) .cal-day-num { color: #2C3E50 !important; }

    /* Day number */
    .cal-day-num {
        font-size: .75rem; font-weight: 700; color: #94a3b8;
        margin-bottom: 5px; display: block; line-height: 1;
    }
    .cal-today .cal-day-num {
        background: #4f8ef7; color: #fff; border-radius: 50%;
        width: 20px; height: 20px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: .68rem;
    }
    .cal-cell-content { display: flex; flex-direction: column; gap: 3px; }

    /* Workout pill inside cell */
    .cal-pill {
        display: flex; align-items: center; gap: 4px;
        border-radius: 5px; padding: 3px 6px;
        font-size: .67rem; font-weight: 600; line-height: 1.3;
        max-width: 100%; overflow: hidden;
    }
    .cal-pill-name {
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        flex: 1; min-width: 0;
    }
    .cal-pill-status { flex-shrink: 0; font-size: .7rem; }
    .cal-pill-status.done  { color: #16a34a; }
    .cal-pill-status.todo  { color: #94a3b8; }

    /* ── Legend ───────────────────────────────────────────────────────────── */
    .legend-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; display: inline-block; }

    /* ── Side panel ───────────────────────────────────────────────────────── */
    #day-panel {
        position: sticky; top: 80px;
        background: #fff; border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,.07);
        overflow: hidden;
    }
    #day-panel-header {
        padding: 1rem 1.25rem;
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }
    #day-panel-date { font-size: 1rem; font-weight: 700; color: #fff; }
    #day-panel-sub  { font-size: .8rem; color: #94a3b8; margin-top: 2px; }
    #day-panel-body { padding: 1rem 1.1rem; }

    /* Workout card in panel */
    .entry-card {
        border-radius: 12px; border: 1.5px solid #e2e8f0;
        margin-bottom: .75rem; overflow: hidden;
        transition: border-color .2s, background .2s;
    }
    .entry-card.is-done { background: #f0fdf4; border-color: #86efac; }
    .entry-card:last-child { margin-bottom: 0; }

    .entry-card-header {
        padding: .6rem .9rem;
        display: flex; align-items: center; gap: .5rem;
        border-bottom: 1px solid #f1f5f9;
    }
    .entry-card.is-done .entry-card-header { border-bottom-color: #bbf7d0; }
    .entry-card-body { padding: .75rem .9rem; }

    .entry-program-name { font-weight: 700; font-size: .9rem; color: #1e293b; }

    .entry-badge {
        display: inline-flex; align-items: center;
        padding: .15rem .55rem; border-radius: 20px;
        font-size: .68rem; font-weight: 600;
    }

    /* Exercise mini-list */
    .ex-list { list-style: none; padding: 0; margin: .6rem 0 .75rem; }
    .ex-list li {
        display: flex; justify-content: space-between; align-items: center;
        padding: .3rem 0; border-bottom: 1px solid #f1f5f9;
        font-size: .8rem;
    }
    .ex-list li:last-child { border-bottom: none; }
    .ex-name  { color: #334155; font-weight: 500; }
    .ex-badge {
        background: #f1f5f9; color: #475569;
        border-radius: 5px; padding: .1rem .45rem;
        font-size: .7rem; font-weight: 600; white-space: nowrap;
    }

    /* Complete button */
    .btn-complete {
        border-radius: 8px; font-size: .82rem; font-weight: 600;
        padding: .35rem .9rem; transition: all .15s; width: 100%;
        margin-bottom: .6rem;
    }

    /* Notes */
    .notes-row { display: flex; gap: .5rem; }
    .notes-row textarea {
        border-radius: 8px; border: 1.5px solid #e2e8f0;
        font-size: .8rem; padding: .4rem .6rem; resize: vertical;
        flex: 1; min-height: 56px;
        transition: border-color .15s;
    }
    .notes-row textarea:focus { outline: none; border-color: #4f8ef7; }
    .notes-save-btn {
        border-radius: 8px; font-size: .8rem; font-weight: 600;
        padding: .4rem .8rem; align-self: flex-end;
        white-space: nowrap;
    }

    /* Rest day */
    .rest-day {
        text-align: center; padding: 2rem 1rem; color: #94a3b8;
    }
    .rest-day .rest-icon { font-size: 2rem; display: block; margin-bottom: .5rem; }

    /* Empty state */
    .empty-panel {
        text-align: center; padding: 2.5rem 1rem; color: #94a3b8;
    }
    .empty-panel .empty-icon { font-size: 2.5rem; display: block; margin-bottom: .75rem; }

    /* Add workout form */
    .add-workout-form select { font-size: .82rem; }
    .btn-remove-entry {
        background: none; border: none; color: #ef4444;
        font-size: .85rem; line-height: 1; padding: 0 2px;
        cursor: pointer; opacity: .6; transition: opacity .15s;
    }
    .btn-remove-entry:hover { opacity: 1; }
</style>

<div class="cal-page">
<div class="container">

    <div class="row g-4">

        @* ── Left: calendar ─────────────────────────────────────────────────── *@
        <div class="col-lg-8">

            @* Month navigation *@
            <div class="d-flex align-items-center justify-content-between mb-3">
                <a asp-action="Index" asp-route-year="@prevYear" asp-route-month="@prevMonth"
                   class="cal-nav-btn">&#8592;</a>
                <span class="cal-month-title">@monthName</span>
                <a asp-action="Index" asp-route-year="@nextYear" asp-route-month="@nextMonth"
                   class="cal-nav-btn">&#8594;</a>
            </div>

            <div class="cal-card">
                @* Day-of-week header row *@
                <div class="cal-grid cal-head-row">
                    @foreach (var dn in dayNames)
                    {
                        <div class="cal-head">@dn</div>
                    }
                </div>

                @* Calendar cells *@
                <div class="cal-grid" id="cal-grid">
                    @* Leading empty cells *@
                    @for (int i = 0; i < firstOffset; i++)
                    {
                        <div class="cal-cell cal-empty"></div>
                    }

                    @for (int d = 1; d <= daysInMonth; d++)
                    {
                        var cellDate   = new DateTime(year, month, d);
                        bool isToday   = cellDate == today;
                        var dayEntries = byDay.TryGetValue(d, out var de) ? de : new List<CalendarEntry>();
                        bool hasWork   = dayEntries.Any();
                        bool allDone   = hasWork && dayEntries.All(e => e.IsCompleted);

                        string cellClass = "cal-cell";
                        if (isToday) cellClass += " cal-today";
                        if (hasWork) cellClass += " cal-has-workout";
                        if (allDone) cellClass += " cal-all-done";

                        <div class="@cellClass"
                             id="cell-@(year)-@(month)-@d"
                             onclick="openDay(@year, @month, @d)">
                            <span class="cal-day-num">@d</span>
                            <div class="cal-cell-content">
                                @foreach (var entry in dayEntries)
                                {
                                    var dotColor = programColor.TryGetValue(entry.WorkoutProgramId, out var c) ? c : "#6c757d";
                                    var bgAlpha  = entry.WorkoutProgramId > 0 ? "22" : "22";
                                    <div class="cal-pill"
                                         id="pill-@entry.Id"
                                         style="background:@(dotColor)22; border: 1px solid @(dotColor)44;">
                                        <span class="cal-pill-name" style="color:@dotColor;">
                                            @entry.WorkoutProgram.Name
                                        </span>
                                        <span class="cal-pill-status @(entry.IsCompleted ? "done" : "todo")"
                                              id="pill-status-@entry.Id">
                                            @(entry.IsCompleted ? "✓" : "○")
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Legend *@
            @if (programColor.Any())
            {
                <div class="d-flex flex-wrap gap-3 mt-3 px-1">
                    @foreach (var (pid, col) in programColor)
                    {
                        var prog = Model.First(e => e.WorkoutProgramId == pid).WorkoutProgram;
                        <div class="d-flex align-items-center gap-2">
                            <span class="legend-dot" style="background:@col;"></span>
                            <span class="small text-muted">@prog.Name</span>
                        </div>
                    }
                </div>
            }

        </div>

        @* ── Right: day detail panel ─────────────────────────────────────────── *@
        <div class="col-lg-4">
            <div id="day-panel">
                <div id="day-panel-header">
                    <div id="day-panel-date">Select a day</div>
                    <div id="day-panel-sub">Click any day to see workouts</div>
                </div>
                <div id="day-panel-body">
                    <div class="empty-panel">
                        <span class="empty-icon">&#128197;</span>
                        <p class="mb-0 small">Click a day on the calendar to view scheduled workouts.</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
(function () {
    const aft = document.querySelector('input[name="__RequestVerificationToken"]').value;

    const colorList = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            new[] { "#4f8ef7", "#22c55e", "#a855f7", "#f97316", "#06b6d4" }
        )
    );

    const allPrograms = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            allProgramsList.Select(p => new { id = p.Id, name = p.Name })
        )
    );

    // programId (string) → color
    const programColorMap = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            programColor.ToDictionary(kv => kv.Key.ToString(), kv => kv.Value)
        )
    );

    async function post(url, params) {
        const res = await fetch(url, {
            method: 'POST',
            headers: {
                'RequestVerificationToken': aft,
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: new URLSearchParams(params).toString()
        });
        return res.json();
    }

    // ── Selected cell tracking ─────────────────────────────────────────────
    let selectedCellId = null;

    function selectCell(year, month, day) {
        if (selectedCellId) {
            const prev = document.getElementById(selectedCellId);
            if (prev) prev.classList.remove('selected-day');
        }
        const id = `cell-${year}-${month}-${day}`;
        selectedCellId = id;
        const cell = document.getElementById(id);
        if (cell) cell.classList.add('selected-day');
    }

    // ── Open day panel ─────────────────────────────────────────────────────
    let currentYear, currentMonth, currentDay;

    window.openDay = async function (year, month, day) {
        currentYear = year; currentMonth = month; currentDay = day;

        selectCell(year, month, day);

        const date = new Date(year, month - 1, day);
        document.getElementById('day-panel-date').textContent =
            date.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
        document.getElementById('day-panel-sub').textContent = 'Loading…';

        const body = document.getElementById('day-panel-body');
        body.innerHTML = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-secondary"></div></div>';

        let data;
        try {
            data = await fetch(`/Calendar/GetDayEntries?year=${year}&month=${month}&day=${day}`)
                         .then(r => r.json());
        } catch {
            body.innerHTML = '<p class="text-danger small p-3">Failed to load workouts.</p>';
            document.getElementById('day-panel-sub').textContent = '';
            return;
        }

        document.getElementById('day-panel-sub').textContent =
            data.length ? `${data.length} workout${data.length > 1 ? 's' : ''} scheduled` : '';

        if (!data.length) {
            body.innerHTML = `
                <div class="rest-day">
                    <span class="rest-icon">&#128564;</span>
                    <p class="mb-0 small fw-semibold">Rest Day</p>
                    <p class="mb-0 small text-muted">No workouts scheduled.</p>
                </div>`;
            body.appendChild(buildAddForm());
            return;
        }

        body.innerHTML = '';
        data.forEach((entry, idx) => {
            body.appendChild(buildEntryCard(entry, idx));
        });
        body.appendChild(buildAddForm());
    };

    // ── Build entry card ───────────────────────────────────────────────────
    function buildEntryCard(entry, idx) {
        const color = colorList[idx % colorList.length];
        const isDone = entry.isCompleted;

        const card = document.createElement('div');
        card.className = 'entry-card' + (isDone ? ' is-done' : '');
        card.id = `entry-card-${entry.id}`;

        const weekBadge = entry.weekNumber
            ? `<span class="entry-badge" style="background:#f1f5f9;color:#475569;">Week ${entry.weekNumber}</span>`
            : '';
        const focusBadge = entry.dayFocus
            ? `<span class="entry-badge ms-1" style="background:${color}18;color:${color};">${entry.dayFocus}</span>`
            : '';

        // Exercises list
        let exHtml = '';
        if (entry.exercises && entry.exercises.length) {
            const rows = entry.exercises.map(ex =>
                `<li>
                    <span class="ex-name">${escHtml(ex.name)}</span>
                    <span class="ex-badge">${ex.sets}×${ex.reps} ${ex.unit}</span>
                </li>`
            ).join('');
            exHtml = `<ul class="ex-list">${rows}</ul>`;
        }

        const btnClass = isDone ? 'btn-success' : 'btn-outline-secondary';
        const btnTxt   = isDone ? '&#10003; Completed' : 'Mark Complete';

        card.innerHTML = `
<div class="entry-card-header" style="border-left:4px solid ${color};">
    <div class="flex-grow-1">
        <div class="entry-program-name">${escHtml(entry.programName)}</div>
        <div class="mt-1">${weekBadge}${focusBadge}</div>
    </div>
    <button class="btn-remove-entry" onclick="removeEntry(${entry.id})" title="Remove">✕</button>
</div>
<div class="entry-card-body">
    ${exHtml}
    <button type="button" class="btn btn-complete ${btnClass}"
            id="btn-complete-${entry.id}"
            onclick="toggleComplete(${entry.id}, this)">
        ${btnTxt}
    </button>
    <div class="notes-row">
        <textarea id="note-${entry.id}" placeholder="Add a note…" maxlength="500">${escHtml(entry.notes ?? '')}</textarea>
        <button type="button" class="btn btn-sm btn-outline-primary notes-save-btn"
                onclick="saveNote(${entry.id})">Save</button>
    </div>
</div>`;

        return card;
    }

    // ── Toggle complete ────────────────────────────────────────────────────
    window.toggleComplete = async function (id, btn) {
        btn.disabled = true;
        const data = await post('/Calendar/ToggleComplete', { id });
        if (!data.success) { btn.disabled = false; return; }

        const isDone = data.isCompleted;
        const card   = document.getElementById(`entry-card-${id}`);
        if (card) {
            card.classList.toggle('is-done', isDone);
            btn.className = `btn btn-complete ${isDone ? 'btn-success' : 'btn-outline-secondary'}`;
            btn.innerHTML = isDone ? '&#10003; Completed' : 'Mark Complete';
        }
        btn.disabled = false;

        // Update pill in calendar cell
        const pillStatus = document.getElementById(`pill-status-${id}`);
        if (pillStatus) {
            pillStatus.className = `cal-pill-status ${isDone ? 'done' : 'todo'}`;
            pillStatus.textContent = isDone ? '✓' : '○';
        }

        // Update cell tint if all entries for that day are now done
        if (currentYear && currentMonth && currentDay) {
            refreshCellTint(currentYear, currentMonth, currentDay);
        }
    };

    function refreshCellTint(year, month, day) {
        const cell = document.getElementById(`cell-${year}-${month}-${day}`);
        if (!cell) return;
        const pills = cell.querySelectorAll('.cal-pill');
        if (!pills.length) return;
        const allDone = [...pills].every(p => {
            const s = p.querySelector('.cal-pill-status');
            return s && s.textContent.trim() === '✓';
        });
        cell.classList.toggle('cal-all-done', allDone);
    }

    // ── Save note ──────────────────────────────────────────────────────────
    window.saveNote = async function (id) {
        const notes = document.getElementById(`note-${id}`).value;
        const btn   = event.currentTarget;
        btn.disabled = true;
        btn.textContent = '…';
        await post('/Calendar/AddNote', { id, notes });
        btn.disabled = false;
        btn.textContent = 'Save';
    };

    // ── Build add-workout form ─────────────────────────────────────────────
    function buildAddForm() {
        const wrapper = document.createElement('div');
        wrapper.className = 'add-workout-form mt-2';

        const options = allPrograms.map(p =>
            `<option value="${p.id}">${escHtml(p.name)}</option>`
        ).join('');

        wrapper.innerHTML = `
            <hr class="my-2">
            <select id="add-program-select" class="form-select form-select-sm mb-2">
                <option value="">— Select a program —</option>
                ${options}
            </select>
            <button type="button" class="btn btn-sm btn-outline-primary w-100"
                    onclick="addEntry()">+ Add Workout</button>`;
        return wrapper;
    }

    // ── Add entry ──────────────────────────────────────────────────────────
    window.addEntry = async function () {
        const select = document.getElementById('add-program-select');
        const programId = select.value;
        if (!programId) { select.focus(); return; }

        const data = await post('/Calendar/AddEntry', {
            programId,
            year:  currentYear,
            month: currentMonth,
            day:   currentDay
        });

        if (!data.success) { alert(data.message); return; }

        addPillToCell(currentYear, currentMonth, currentDay,
                      data.entryId, programId, data.programName);
        openDay(currentYear, currentMonth, currentDay);
    };

    // ── Remove entry ───────────────────────────────────────────────────────
    window.removeEntry = async function (id) {
        const data = await post('/Calendar/RemoveEntry', { id });
        if (!data.success) { alert(data.message); return; }

        const pill = document.getElementById(`pill-${id}`);
        if (pill) pill.remove();

        refreshCellTint(currentYear, currentMonth, currentDay);
        openDay(currentYear, currentMonth, currentDay);
    };

    // ── Add pill to calendar cell after AddEntry ───────────────────────────
    function addPillToCell(year, month, day, entryId, programId, programName) {
        const cell = document.getElementById(`cell-${year}-${month}-${day}`);
        if (!cell) return;

        let content = cell.querySelector('.cal-cell-content');
        if (!content) {
            content = document.createElement('div');
            content.className = 'cal-cell-content';
            cell.appendChild(content);
        }

        let color = programColorMap[programId.toString()];
        if (!color) {
            color = colorList[Object.keys(programColorMap).length % colorList.length];
            programColorMap[programId.toString()] = color;
        }

        const pill = document.createElement('div');
        pill.className = 'cal-pill';
        pill.id = `pill-${entryId}`;
        pill.style.cssText = `background:${color}22; border:1px solid ${color}44;`;
        pill.innerHTML = `
            <span class="cal-pill-name" style="color:${color};">${escHtml(programName)}</span>
            <span class="cal-pill-status todo" id="pill-status-${entryId}">○</span>`;
        content.appendChild(pill);

        cell.classList.add('cal-has-workout');
    }

    // ── Utility ────────────────────────────────────────────────────────────
    function escHtml(str) {
        if (!str) return '';
        return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Auto-select today if it has workouts ───────────────────────────────
    (function autoSelectToday() {
        const todayYear  = @year;
        const todayMonth = @month;
        const todayDay   = @today.Day;
        const todayCell  = document.getElementById(`cell-${todayYear}-${todayMonth}-${todayDay}`);
        if (todayCell && todayCell.querySelector('.cal-pill')) {
            openDay(todayYear, todayMonth, todayDay);
        }
    })();

})();
